{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/checks/hooks/stop_gate.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
